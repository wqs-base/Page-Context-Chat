{
  "manifest_version": 3,
  "name": "Page Context Chat",
  "version": "1.7.0",
  "minimum_chrome_version": "116",
  "description": "通过本地服务采集当前页面上下文，并在页面上提供设置面板（跟随鼠标 / 虚拟光标 / 执行 JS）。",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8090/*",
    "http://localhost:8090/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开页面助手设置"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
